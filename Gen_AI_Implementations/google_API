# ============================================================================
# Multimodal Input (Text + Images)
# ============================================================================

def multimodal_generation(text_prompt: str, image_path: str):
    """
    Generate content from both text and image inputs.
    
    Args:
        text_prompt: Text description/question
        image_path: Path to image file
    """
    # This is a new import for image processing
    # pip install pillow
    import PIL.Image
    
    # Load image
    img = PIL.Image.open(image_path)
    
    # Generate content with text and image
    response = client.models.generate_content(
        model="gemini-2.0-flash-exp",
        contents=[text_prompt, img]
    )
    return response.text


# ============================================================================
# Error Handling
# ============================================================================

def safe_generate_content(prompt: str):
    """
    Generate content with proper error handling.
    """
    try:
        response = client.models.generate_content(
            model="gemini-2.0-flash",
            contents=prompt
        )
        
        # Check if response was blocked
        if hasattr(response, 'prompt_feedback') and response.prompt_feedback.block_reason:
            print(f"Response blocked: {response.prompt_feedback.block_reason}")
            return None
        
        return response.text
    
    except Exception as e:
        print(f"Error generating content: {e}")
        return None

# ============================================================================
# Asynchronous Calls
# ============================================================================

async def asynchronous_call(prompt: str):
    """
    Make an asynchronous call to the API.
    """
    response = await client.aio.models.generate_content(
        model="gemini-2.0-flash",
        contents=prompt
    )
    return response.text

# ============================================================================
# User defined tools
# ============================================================================
'''
User can define functions to act as tools to be used by the AI Agent.
These tools can be used to perform tasks that are not possible with the model alone.
A user can ask the AI for something in natural language and the AI will use the tools to perform the task.

This example shows the user asking the AI about a specific number, and if it is even or odd.
The AI agent parses the query for the number, and uses the get_even_odd 'tool' to decide the response.
'''
def get_even_odd(number: int) -> str:
    """determine if a number is even or odd.

    Args:
        number: required, The number to check
    """
    print(f'Called with: {number=}')
    return f"The number {number} is even" if number % 2 == 0 else f"The number {number} is odd"

# ============================================================================
# Google Search tool
# ============================================================================
def web_search_generation(prompt: str, model_name: str = "gemini-2.0-flash") -> str:
    response = client.models.generate_content(
        model=model_name,
        contents=prompt,
        config=types.GenerateContentConfig(
            tools=[
                types.Tool(
                    google_search=types.GoogleSearch()
                    )
                ]
            )
        )
    return response.text


# ============================================================================
# Structured Response | JSON
# ============================================================================
from pydantic import BaseModel # Uses pydantic for class structure
class CountryInfo(BaseModel):
    name: str
    population: int
    capital: str
    continent: str
    major_cities: list[str]
    gdp: int
    official_language: str
    total_area_sq_mi: int

def country_info(prompt: str, model_name: str = "gemini-2.0-flash"):
    """
    Get structured country info response (as JSON) using Gemini, using Pydantic model for schema,
    and enabling the Google Search tool for augmentation.

    Args:
        prompt: The country's name or your query.
        model_name: Gemini model name.

    Returns:
        An instance of CountryInfo parsed from the model's JSON response.
    """
    response = client.models.generate_content(
        model=model_name,
        contents=prompt,
        config=types.GenerateContentConfig(
            tools=[
                types.Tool(
                    google_search=types.GoogleSearch()
                )
            ],
            response_mime_type='application/json',
            response_schema=CountryInfo
        )
    )
    return response.parsed

