load_dotenv()

# Set API key from environment variable
API_KEY = os.getenv("GOOGLE_API_KEY")

# Create a single client object (centralized API access)
client = genai.Client(api_key=API_KEY)

# ============================================================================
# Basic Usage - Text Generation
# ============================================================================

def basic_text_generation(prompt: str, model_name: str = "gemini-2.0-flash") -> str:
    """
    Basic text generation using Gemini.
    
    Args:
        prompt: The input prompt/question
        model_name: The model to use (default: "gemini-2.0-flash")
    
    Returns:
        Generated text response
    """
    response = client.models.generate_content(
        model=model_name,
        contents=prompt
    )
    return response.text


# ============================================================================
# Chat Conversation
# ============================================================================
def chat_conversation(chat_prompt_1, chat_prompt_2, chat_prompt_3):
    """
    Example of a multi-turn conversation with Gemini.
    """
    # Create a new chat session
    chat = client.chats.create(
        model="gemini-2.0-flash"
    )
    
    # First message
    response = chat.send_message(
        message=chat_prompt_1
    )
    print(f"Assistant: {response.text}")
    
    # Follow-up message (context is maintained)
    response = chat.send_message(
        message=chat_prompt_2
    )
    print(f"Assistant: {response.text}")

    # Follow-up message (context is maintained)
    response = chat.send_message(
        message=chat_prompt_3
    )
    print(f"Assistant: {response.text}")
    
    # Access conversation history
    history = chat.get_history()
    for message in history:
        print(f"{message.role}: {message.parts[0].text}")


# ============================================================================
# Streaming Response
# ============================================================================

def streaming_generation(prompt: str):
    """
    Stream responses token by token for better UX.
    """
    response = client.models.generate_content(
        model="gemini-2.0-flash",
        contents=prompt,
        config=types.GenerateContentConfig(stream=True)
    )
    
    for chunk in response:
        print(chunk.text, end="", flush=True)
    print()  # New line after streaming


# ============================================================================
# Advanced Configuration
# ============================================================================

def advanced_generation(prompt: str):
    """
    Generation with custom parameters (temperature, top_p, etc.).
    temperature: Controls randomness. Higher values (e.g., 0.8) make output more creative and diverse; lower values (e.g., 0.2) make it more focused and deterministic.
    top_p: Nucleus sampling. With top_p=1.0, sampling considers all possible tokens (equal to pure temperature sampling). Lowering top_p (e.g., 0.8) only considers the smallest set of tokens whose cumulative probability exceeds top_p, encouraging more likely outputs.
    top_k: Limits sampling to the top_k most likely tokens at each step. For example, top_k=40 means only the 40 highest-probability next words are considered. Setting top_k lower makes results more predictable, higher allows for more variety.
    Tuning tips:
        - Raise temperature for more creativity, lower for precision.
        - top_p and top_k can be used together, but usually one is sufficient.
        - You might use temperature=0.7, top_p=0.8, top_k=40 for balanced creativity and relevance.
    """
    response = client.models.generate_content(
        model="gemini-2.0-flash",
        contents=prompt,
        config=types.GenerateContentConfig(
            temperature=0.7,
            top_p=0.8,
            top_k=40,
            max_output_tokens=2048,
        )
    )
    return response.text


